{
  "name": "glineze-node-typescript",
  "version": "3.0.3",
  "description": "",
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "NODE_ENV=production node --env-file=.env dist/app.js",
    "start:dev": "NODE_ENV=development node --env-file=.env -r ts-node/register ./src/app.ts",
    "build": "tsc && mkdir -p dist/assets && cp src/services/webapi/assets/status-operational.png dist/assets/status-operational.png",
    "dev": "npm run start:dev",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint": "~9.6.1",
    "@types/eslint-config-prettier": "~6.11.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@hapi/iron": "^7.0.1",
    "@notionhq/client": "^5.20.0",
    "@picocss/pico": "^2.1.1",
    "@tabler/icons-webfont": "^3.46.0",
    "axios": "^1.15.2",
    "csrf-sync": "^4.2.1",
    "date-fns": "^4.1.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "eta": "^4.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "htmx.org": "^2.0.10",
    "memorystore": "^1.6.8",
    "node-cron": "^4.2.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.3.6"
