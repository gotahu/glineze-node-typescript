NODE_ENV=development
PORT=10000

# Existing integrations
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_RELAY_WEBHOOK=https://discord.com/api/webhooks/replace/me
NOTION_TOKEN=replace-with-notion-integration-token
NOTION_CONFIGURATION_DATABASEID=replace-with-notion-database-id

SESAME_ENABLED=false
NOTION_AUTOMATION_ENABLED=false
# Required only when NOTION_AUTOMATION_ENABLED=true
# NOTION_AUTOMATION_VERIFICATION_TOKEN=replace-me
# NOTION_AUTOMATION_ALLOWED_AUTOMATION_IDS=id-1,id-2
# NOTION_AUTOMATION_ALLOWED_ACTION_IDS=id-1,id-2
# NOTION_AUTOMATION_ALLOWED_DATABASE_IDS=id-1,id-2

REPOSITORY_PATH=
BRANCH=refs/heads/main

# Admin console: disabled by default. The remaining ADMIN_* values are required
# only when ADMIN_ENABLED=true.
ADMIN_ENABLED=false
# ADMIN_BASE_URL=https://your-glineze.example
# ADMIN_AUTH_SECRET=generate-with-openssl-rand-base64-48
# ADMIN_NOTION_LOGIN_BLOCK_ID=replace-with-notion-block-id
ADMIN_TOKEN_ROTATION_CRON=5 4 * * *
ADMIN_TOKEN_TTL_HOURS=48
ADMIN_SESSION_TTL_HOURS=12
